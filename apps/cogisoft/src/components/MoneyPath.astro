---
/*
  MoneyPath.astro — the page signature: the path instrument. A sticky panel
  beside the zones behaves like the product being sold — a live gauge. Its
  vertical track fills with steel as the reader scrolls the four zones; each
  node ignites coral once its zone is passed (structure fills, evidence
  ignites); a mono readout names the current zone, and completing the path
  flips the readout to "One contract". On mobile the panel folds into a thin
  sticky progress strip. Scroll IS the money path — the page answers with
  numbers about itself.

  Zones keep the hybrid frame: an owner-language question, one situation line,
  artifact chips, the "we run" line. 01–04 numbering is honest structure — the
  money path is a real sequence. Without JS the panel is a static legend and
  every zone is simply visible.
*/
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Zone {
  id: string;
  stop: UIKey;
  q: UIKey;
  situation: UIKey;
  artifacts: ReadonlyArray<{ key: UIKey; spike?: boolean }>;
  run: UIKey;
}

const ZONES: ReadonlyArray<Zone> = [
  {
    id: "01",
    stop: "path.stop.1",
    q: "zone.1.q",
    situation: "zone.1.situation",
    artifacts: [
      { key: "zone.1.a1" },
      { key: "zone.1.a2" },
      { key: "zone.1.a3" },
      { key: "zone.1.a4" },
    ],
    run: "zone.1.run",
  },
  {
    id: "02",
    stop: "path.stop.2",
    q: "zone.2.q",
    situation: "zone.2.situation",
    artifacts: [
      { key: "zone.2.a1" },
      { key: "zone.2.a2" },
      { key: "zone.2.a3" },
      { key: "zone.2.a4" },
    ],
    run: "zone.2.run",
  },
  {
    id: "03",
    stop: "path.stop.3",
    q: "zone.3.q",
    situation: "zone.3.situation",
    artifacts: [{ key: "zone.3.a1" }, { key: "zone.3.a2" }, { key: "zone.3.a3", spike: true }],
    run: "zone.3.run",
  },
  {
    id: "04",
    stop: "path.stop.4",
    q: "zone.4.q",
    situation: "zone.4.situation",
    artifacts: [{ key: "zone.4.a1" }, { key: "zone.4.a2" }, { key: "zone.4.a3" }],
    run: "zone.4.run",
  },
];
---

<div
  id="path"
  class="mx-auto max-w-6xl px-6"
  data-zone-word={t("panel.zone")}
  data-end-word={t("panel.end")}
>
  <!-- Mobile: the instrument folded into a sticky progress strip -->
  <div class="strip sticky top-0 z-10 -mx-6 px-6 py-3 backdrop-blur-sm lg:hidden" aria-hidden="true">
    <div class="flex items-center gap-2">
      {ZONES.map((zone, i) => (
        <div class="seg-h relative h-[3px] flex-1 overflow-hidden rounded-full" data-seg={i}>
          <div class="seg-h-fill absolute inset-y-0 left-0 w-full origin-left"></div>
        </div>
      ))}
    </div>
    <p class="readout mt-2 font-mono text-[10px] uppercase tracking-[0.22em] text-muted-foreground"></p>
  </div>

  <div class="grid gap-10 lg:grid-cols-[15rem_1fr] lg:gap-16">
    <!-- Desktop: the path instrument -->
    <aside class="hidden lg:block" aria-hidden="true">
      <div class="panel sticky top-24 rounded-xl border border-border bg-card/60 p-5">
        <p class="font-mono text-[10px] uppercase tracking-[0.26em] text-accent">
          {t("panel.title")}
        </p>
        <div class="mt-5 flex gap-4">
          <div class="track relative w-[3px] rounded-full">
            <div class="track-fill absolute inset-x-0 top-0 rounded-full"></div>
          </div>
          <ol class="m-0 flex list-none flex-col justify-between p-0">
            {ZONES.map((zone, i) => (
              <li class="stop flex items-center gap-3" data-seg={i}>
                <span class="stop-node flex h-7 w-7 items-center justify-center rounded-md border font-mono text-[10px] font-bold">
                  {zone.id}
                </span>
                <span class="font-mono text-[10px] uppercase tracking-[0.2em] text-muted-foreground">
                  {t(zone.stop)}
                </span>
              </li>
            ))}
          </ol>
        </div>
        <p class="readout mt-6 border-t border-border pt-4 font-mono text-[10px] uppercase tracking-[0.22em] text-muted-foreground"></p>
      </div>
    </aside>

    <!-- The zones -->
    <div class="zones min-w-0">
      {
        ZONES.map((zone) => (
          <section class="zone reveal py-14 sm:py-16">
            <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">
              <span class="mr-3 font-mono text-base font-bold text-accent sm:text-lg" aria-hidden="true">
                {zone.id}
              </span>
              {t(zone.q)}
            </h2>
            <p class="mt-3 max-w-xl text-lg leading-relaxed text-muted-foreground">
              <span class="text-accent" aria-hidden="true">
                —{" "}
              </span>
              {t(zone.situation)}
            </p>
            <ul class="mt-6 flex list-none flex-wrap gap-2.5 p-0">
              {zone.artifacts.map((a) => (
                <li
                  class:list={[
                    "rounded-lg border bg-card px-3.5 py-2 font-mono text-xs",
                    a.spike ? "border-primary/45 text-primary" : "border-border text-foreground",
                  ]}
                >
                  {t(a.key)}
                </li>
              ))}
            </ul>
            <p class="mt-5 font-mono text-xs tracking-wide text-accent">
              <b class="font-semibold text-foreground">{t("zone.run.prefix")}</b> {t(zone.run)}
            </p>
          </section>
        ))
      }

      <section class="onehand reveal py-16">
        <h2 class="max-w-lg font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
          {t("onehand.title")}<span class="full-stop" aria-hidden="true"></span>
        </h2>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
          {t("onehand.body.1")}<strong class="font-semibold text-foreground"
            >{t("onehand.body.strong")}</strong
          >{t("onehand.body.2")}
        </p>
      </section>
    </div>
  </div>
</div>

<style>
  /* ── The instrument ──────────────────────────────────────────────────────── */
  .track {
    background: var(--border);
  }
  .track-fill {
    height: calc(var(--path-p, 0) * 100%);
    background: var(--accent);
    box-shadow: 0 0 10px -2px color-mix(in oklch, var(--accent) 60%, transparent);
  }

  .stop-node {
    background: var(--card);
    border-color: var(--border);
    color: var(--accent);
    transition:
      border-color 0.45s,
      color 0.45s,
      box-shadow 0.55s;
  }
  .stop.lit .stop-node {
    border-color: var(--primary);
    color: var(--primary);
    box-shadow: 0 0 18px -4px color-mix(in oklch, var(--primary) 70%, transparent);
  }
  .panel .readout,
  .strip .readout {
    min-height: 1em;
  }
  .panel.done .readout,
  .strip.done .readout {
    color: var(--primary);
  }

  /* Mobile strip */
  .strip {
    background: color-mix(in srgb, var(--background) 82%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .seg-h {
    background: var(--border);
  }
  .seg-h-fill {
    transform: scaleX(var(--seg-p, 0));
    background: var(--accent);
  }
  .seg-h.lit .seg-h-fill {
    background: var(--primary);
  }

  /* ── Reveal (JS-gated so no-JS keeps everything visible) ────────────────── */
  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  :global(html.js) .reveal.in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .stop-node {
      transition: none;
    }
  }
</style>

<script>
  document.documentElement.classList.add("js");

  const root = document.getElementById("path");
  const zonesWrap = root?.querySelector<HTMLElement>(".zones");
  const panel = root?.querySelector<HTMLElement>(".panel");
  const strip = root?.querySelector<HTMLElement>(".strip");
  const readouts = root ? [...root.querySelectorAll<HTMLElement>(".readout")] : [];
  const stops = root ? [...root.querySelectorAll<HTMLElement>(".stop")] : [];
  const segs = root ? [...root.querySelectorAll<HTMLElement>(".seg-h")] : [];
  const zones = root ? [...root.querySelectorAll<HTMLElement>(".zones .zone")] : [];

  const LABELS = zones.length
    ? [...root!.querySelectorAll<HTMLElement>(".stop span:last-child")].map((el) =>
        el.textContent!.trim(),
      )
    : [];
  const ZONE_WORD = root?.dataset.zoneWord ?? "";
  const END_WORD = root?.dataset.endWord ?? "";

  // Reveal on scroll
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("in");
        io.unobserve(entry.target);
      }
    },
    { threshold: 0.2 },
  );
  root?.querySelectorAll(".reveal").forEach((el) => io.observe(el));

  // The gauge: progress through the zones, read at the viewport's midline.
  if (zonesWrap && zones.length) {
    const N = zones.length;
    let ticking = false;

    const apply = () => {
      ticking = false;
      const mid = window.innerHeight * 0.55;
      const rect = zonesWrap.getBoundingClientRect();
      const total = rect.height;
      const p = Math.min(1, Math.max(0, (mid - rect.top) / total));

      root!.style.setProperty("--path-p", p.toFixed(4));

      // Which zone is the midline inside?
      let current = -1;
      zones.forEach((z, i) => {
        const r = z.getBoundingClientRect();
        if (mid >= r.top) current = i;
        const done = mid >= r.bottom;
        stops[i]?.classList.toggle("lit", done);
        segs[i]?.classList.toggle("lit", done);
        segs[i]?.style.setProperty(
          "--seg-p",
          Math.min(1, Math.max(0, (mid - r.top) / r.height)).toFixed(3),
        );
      });

      const finished = p >= 1;
      panel?.classList.toggle("done", finished);
      strip?.classList.toggle("done", finished);
      const text = finished
        ? END_WORD
        : current >= 0
          ? `${ZONE_WORD} 0${current + 1} / 0${N} · ${LABELS[current] ?? ""}`
          : `${ZONE_WORD} — / 0${N}`;
      readouts.forEach((el) => (el.textContent = text));
    };

    const onScroll = () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(apply);
      }
    };
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll, { passive: true });
    apply();
  }
</script>
