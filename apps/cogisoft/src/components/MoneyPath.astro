---
/*
  MoneyPath.astro — the page signature: the money rail. One vertical steel
  line through the four zones; each node ignites coral as the reader scrolls
  past it (structure fills, evidence ignites), ending in a solid coral node at
  the "one contract" block. A sticky instrument-panel variant was tried on
  2026-08-30 and rejected by the owner — the rail stays a quiet line, not a
  gauge.

  Zones keep the hybrid frame: an owner-language question, one situation line,
  artifact chips, the "we run" line. 01–04 numbering is honest structure — the
  money path is a real sequence. Without JS everything is simply visible.
*/
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Zone {
  id: string;
  q: UIKey;
  situation: UIKey;
  artifacts: ReadonlyArray<{ key: UIKey; spike?: boolean }>;
  run: UIKey;
}

const ZONES: ReadonlyArray<Zone> = [
  {
    id: "01",
    q: "zone.1.q",
    situation: "zone.1.situation",
    artifacts: [
      { key: "zone.1.a1" },
      { key: "zone.1.a2" },
      { key: "zone.1.a3" },
      { key: "zone.1.a4" },
    ],
    run: "zone.1.run",
  },
  {
    id: "02",
    q: "zone.2.q",
    situation: "zone.2.situation",
    artifacts: [
      { key: "zone.2.a1" },
      { key: "zone.2.a2" },
      { key: "zone.2.a3" },
      { key: "zone.2.a4" },
    ],
    run: "zone.2.run",
  },
  {
    id: "03",
    q: "zone.3.q",
    situation: "zone.3.situation",
    artifacts: [{ key: "zone.3.a1" }, { key: "zone.3.a2" }, { key: "zone.3.a3", spike: true }],
    run: "zone.3.run",
  },
  {
    id: "04",
    q: "zone.4.q",
    situation: "zone.4.situation",
    artifacts: [{ key: "zone.4.a1" }, { key: "zone.4.a2" }, { key: "zone.4.a3" }],
    run: "zone.4.run",
  },
];
---

<div id="path" class="mx-auto max-w-6xl px-6">
  <div class="rail-zone relative">
    <div class="rail" aria-hidden="true"></div>

    {
      ZONES.map((zone) => (
        <section class="zone reveal relative py-14 pl-14 sm:py-16 sm:pl-16">
          <div class="node" aria-hidden="true">
            {zone.id}
          </div>
          <h2 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">{t(zone.q)}</h2>
          <p class="mt-3 max-w-xl text-lg leading-relaxed text-muted-foreground">
            <span class="text-accent" aria-hidden="true">
              —{" "}
            </span>
            {t(zone.situation)}
          </p>
          <ul class="mt-6 flex list-none flex-wrap gap-2.5 p-0">
            {zone.artifacts.map((a) => (
              <li
                class:list={[
                  "rounded-lg border bg-card px-3.5 py-2 font-mono text-xs",
                  a.spike ? "border-primary/45 text-primary" : "border-border text-foreground",
                ]}
              >
                {t(a.key)}
              </li>
            ))}
          </ul>
          <p class="mt-5 font-mono text-xs tracking-wide text-accent">
            <b class="font-semibold text-foreground">{t("zone.run.prefix")}</b> {t(zone.run)}
          </p>
        </section>
      ))
    }

    <section class="onehand reveal relative py-16 pl-14 sm:pl-16">
      <div class="node node-terminal" aria-hidden="true"></div>
      <h2 class="max-w-lg font-display text-3xl font-extrabold tracking-tight sm:text-4xl">
        {t("onehand.title")}<span class="full-stop" aria-hidden="true"></span>
      </h2>
      <p class="mt-5 max-w-xl text-lg leading-relaxed text-muted-foreground">
        {t("onehand.body.1")}<strong class="font-semibold text-foreground"
          >{t("onehand.body.strong")}</strong
        >{t("onehand.body.2")}
      </p>
    </section>
  </div>
</div>

<style>
  .rail {
    position: absolute;
    inset-block: 0;
    left: 1.05rem;
    width: 2px;
    background: var(--border);
  }

  .node {
    position: absolute;
    left: 0;
    top: 3.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 0.55rem;
    background: var(--card);
    border: 1.5px solid var(--border);
    font-family: var(--ff-mono);
    font-weight: 700;
    font-size: 11px;
    color: var(--accent);
    transition:
      border-color 0.5s,
      color 0.5s,
      box-shadow 0.6s;
  }

  .zone.lit .node {
    border-color: var(--primary);
    color: var(--primary);
    box-shadow: 0 0 22px -4px color-mix(in oklch, var(--primary) 70%, transparent);
  }

  .node-terminal {
    top: 4.2rem;
    background: var(--primary);
    border-color: var(--primary);
    box-shadow: 0 0 26px -4px color-mix(in oklch, var(--primary) 80%, transparent);
  }

  /* Reveal only exists once JS has arrived (html.js): no-JS keeps it visible. */
  :global(html.js) .reveal {
    opacity: 0;
    transform: translateY(14px);
    transition:
      opacity 0.7s ease,
      transform 0.7s ease;
  }
  :global(html.js) .reveal.in {
    opacity: 1;
    transform: none;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .node {
      transition: none;
    }
  }

  @media (max-width: 640px) {
    .rail {
      left: 0.85rem;
    }
    .node {
      width: 1.8rem;
      height: 1.8rem;
      font-size: 10px;
    }
  }
</style>

<script>
  document.documentElement.classList.add("js");
  const io = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add("in", "lit");
        io.unobserve(entry.target);
      }
    },
    { threshold: 0.25 },
  );
  document.querySelectorAll("#path .reveal").forEach((el) => io.observe(el));
</script>
