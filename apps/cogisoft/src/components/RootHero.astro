---
/*
  RootHero.astro — the hub's opening: pure typography at full width. The thesis
  is one unit of responsibility across the money path, with ownership staying
  on the client's side. Below the CTA, a quiet mono teaser names the four
  stops of the rail that follows. The SolutionLoop diagram is gone — the rail
  IS the mechanism now (see MoneyPath.astro).
*/
import { CONTACT_HREF } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const STOPS: ReadonlyArray<UIKey> = ["path.stop.1", "path.stop.2", "path.stop.3", "path.stop.4"];
---

<section class="mx-auto flex min-h-[88vh] max-w-6xl items-center px-6 pt-28 pb-10 sm:pt-32">
  <div class="min-w-0 max-w-3xl">
    <p
      class="flex items-center gap-2.5 font-mono text-[11px] uppercase tracking-[0.3em] text-accent"
    >
      <span class="led-indicator" aria-hidden="true"></span>
      {t("root.hero.eyebrow")}
    </p>
    <h1
      class="mt-6 font-display text-[2.6rem] leading-[1.04] font-extrabold tracking-tight text-balance sm:text-6xl lg:text-7xl"
    >
      {t("root.hero.title")}<span class="full-stop" aria-hidden="true"></span>
    </h1>
    <p class="mt-7 max-w-xl text-lg leading-relaxed text-muted-foreground">
      {t("root.hero.sub.1")}<strong class="font-semibold text-foreground"
        >{t("root.hero.sub.strong")}</strong
      >{t("root.hero.sub.2")}
    </p>
    <div class="mt-9 flex flex-wrap items-center gap-4">
      <a
        href={CONTACT_HREF}
        target="_blank"
        rel="noopener noreferrer"
        class="glow-primary rounded-lg bg-primary px-7 py-3.5 font-semibold text-primary-foreground transition-[filter] hover:brightness-110"
      >
        {t("root.hero.cta")}
      </a>
      <a
        href="#path"
        class="rounded-lg border border-border px-7 py-3.5 text-muted-foreground transition-colors hover:border-accent/60 hover:text-foreground"
      >
        {t("root.hero.secondary")} ↓
      </a>
    </div>
    <p
      class="mt-14 flex flex-wrap items-center font-mono text-[11px] uppercase tracking-[0.22em] text-muted-foreground"
    >
      {
        STOPS.map((key, i) => (
          <>
            {i > 0 && (
              <span class="px-3.5 tracking-normal text-accent/50" aria-hidden="true">
                ──
              </span>
            )}
            <span>{t(key)}</span>
          </>
        ))
      }
    </p>
  </div>
</section>
