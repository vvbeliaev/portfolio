---
/*
  Contact.astro — the closing CTA. Key props let the root and the offer pages
  keep different copy over one structure (the signals page keeps its original
  "bring me a belief" voice until the offers are revisited).
*/
import { CONTACT_HREF } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

interface Props {
  titleKey?: UIKey;
  subKey?: UIKey;
  noteKey?: UIKey;
}

const {
  titleKey = "contact.title",
  subKey = "contact.sub",
  noteKey = "contact.note",
} = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="mx-auto max-w-3xl px-6 py-24 text-center sm:py-32">
  <h2 class="font-mono text-xs uppercase tracking-[0.3em] text-accent">
    {t("contact.label")}
  </h2>
  <p class="mt-5 font-display text-4xl font-extrabold tracking-tight text-balance sm:text-5xl">
    {t(titleKey)}<span class="full-stop" aria-hidden="true"></span>
  </p>
  <p class="mt-4 text-lg text-muted-foreground">
    {t(subKey)}
  </p>
  <a
    href={CONTACT_HREF}
    target="_blank"
    rel="noopener noreferrer"
    class="glow-primary mt-10 inline-block rounded-lg bg-primary px-8 py-4 font-mono text-sm font-semibold tracking-wide text-primary-foreground transition-[filter] hover:brightness-110"
  >
    @vvbeliaevv
  </a>
  <p class="mt-6 text-sm text-muted-foreground">
    {t(noteKey)}
  </p>
</section>
