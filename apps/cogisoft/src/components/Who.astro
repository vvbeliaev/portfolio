---
/*
  Who.astro — the team and the honest boundaries, side by side. Team framing is
  deliberate (engineering core + contractors per job), Vladimir stays named:
  the two brands are connected in the open, and hourly specialist work is
  routed to vvbeliaev.dev instead of being argued against (the old NotFor).
*/
import { SITE } from "$lib/config";
import { getLangFromUrl, useTranslations } from "$i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="mx-auto max-w-6xl border-t border-border px-6 py-20 sm:py-24">
  <div class="grid gap-12 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <h2 class="font-display text-2xl font-bold tracking-tight">{t("who.title")}</h2>
      <p class="mt-4 max-w-xl leading-relaxed text-muted-foreground">
        {t("who.body")}
      </p>
      <a
        href={SITE.founderUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-5 inline-flex items-center gap-2 font-mono text-[11px] uppercase tracking-[0.2em] text-accent transition-colors hover:text-foreground"
      >
        vvbeliaev.dev ↗
      </a>
    </div>
    <div>
      <h2 class="font-display text-2xl font-bold tracking-tight">{t("bound.title")}</h2>
      <ul class="mt-4 list-none p-0">
        <li class="border-t border-border py-3 text-[15px] text-muted-foreground">
          <strong class="font-semibold text-foreground">{t("bound.1.strong")}</strong>{" "}
          {t("bound.1")}
        </li>
        <li class="border-t border-border py-3 text-[15px] text-muted-foreground">
          <strong class="font-semibold text-foreground">{t("bound.2.strong")}</strong>{" "}
          {t("bound.2")}
        </li>
        <li class="border-t border-border py-3 text-[15px] text-muted-foreground">
          <strong class="font-semibold text-foreground">{t("bound.3.strong")}</strong>{" "}
          {t("bound.3")}{" "}
          <a
            href={SITE.founderUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="text-accent underline underline-offset-4 transition-colors hover:text-foreground"
          >
            vvbeliaev.dev
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>
