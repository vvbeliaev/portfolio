---
/*
  BuildRun.astro — the working model as three purchasable steps: audit (the
  entry) → sprints (the unit of work) → run (the tiers). Steps 01-02 are steel
  (structure), 03 carries the coral border — the run contract is where the
  evidence and the asset live. No prices on the site: the numbers live in the
  direct conversation (see workspace/private/strategy/pricing.md).
*/
import { getLangFromUrl, useTranslations } from "$i18n/utils";
import type { UIKey } from "$i18n/ui";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Step {
  tag: UIKey;
  title: UIKey;
  body: UIKey;
  items: ReadonlyArray<UIKey>;
  note?: UIKey;
  coral?: boolean;
}

const STEPS: ReadonlyArray<Step> = [
  {
    tag: "model.audit.tag",
    title: "model.audit.title",
    body: "model.audit.body",
    items: ["model.audit.1", "model.audit.2", "model.audit.3"],
  },
  {
    tag: "model.sprint.tag",
    title: "model.sprint.title",
    body: "model.sprint.body",
    items: ["model.sprint.1", "model.sprint.2", "model.sprint.3", "model.sprint.4"],
    note: "model.sprint.note",
  },
  {
    tag: "model.run.tag",
    title: "model.run.title",
    body: "model.run.body",
    items: ["model.run.1", "model.run.2", "model.run.3"],
    coral: true,
  },
];
---

<section id="how" class="mx-auto max-w-6xl px-6 py-20 sm:py-24">
  <h2 class="font-mono text-[11px] uppercase tracking-[0.28em] text-accent">{t("model.label")}</h2>
  <p class="mt-4 max-w-3xl font-display text-3xl font-bold tracking-tight text-balance sm:text-4xl">
    {t("model.title")}
  </p>
  <p class="mt-4 max-w-2xl leading-relaxed text-muted-foreground">
    {t("model.intro")}
  </p>

  <div class="mt-10 grid gap-5 lg:grid-cols-3">
    {
      STEPS.map((step) => (
        <article
          class:list={[
            "rounded-xl border bg-card/50 p-6 sm:p-7",
            step.coral ? "border-primary/35" : "border-border",
          ]}
        >
          <span
            class:list={[
              "font-mono text-[11px] uppercase tracking-[0.24em]",
              step.coral ? "text-primary" : "text-accent",
            ]}
          >
            {t(step.tag)}
          </span>
          <h3 class="mt-3 font-display text-xl font-bold tracking-tight sm:text-2xl">
            {t(step.title)}
          </h3>
          <p class="mt-3 text-[15px] leading-relaxed text-muted-foreground">{t(step.body)}</p>
          <ul class="mt-5 list-none p-0">
            {step.items.map((key) => (
              <li class="border-t border-border py-2.5 font-mono text-[12.5px]">
                <span class={step.coral ? "text-primary" : "text-accent"} aria-hidden="true">
                  →{" "}
                </span>
                {t(key)}
              </li>
            ))}
          </ul>
          {step.note && (
            <p class="mt-4 border-t border-border pt-4 text-[13px] leading-relaxed text-muted-foreground">
              {t(step.note)}
            </p>
          )}
        </article>
      ))
    }
  </div>
</section>
